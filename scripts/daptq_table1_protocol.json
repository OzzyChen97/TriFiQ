{
  "schema_version": 1,
  "protocol_id": "daptq-robocasa365-table1-v1",
  "source": {
    "paper": "arXiv:2604.11572v1",
    "repository": "https://github.com/Killerxuuuuu/DA-PTQ",
    "commit": "94476e3a9fd1ad892bbdf44f979dd15373365c2a",
    "repository_license_declared": false,
    "implementation_policy": "clean_room_from_paper_with_source_behavior_audit",
    "semantic_priority": "paper_algorithm_and_appendix"
  },
  "benchmark": {
    "name": "RoboCasa365",
    "split": "target",
    "task_source": "scripts/quantvla_full_context_protocol_v2.json#/table1/tasks",
    "formal_seeds": "0-49",
    "episodes_per_model_row": 2500,
    "flow_steps": 4,
    "execute_steps": 16,
    "primary_metric": "task_macro_success_rate",
    "formal_feedback_allowed": false
  },
  "calibration": {
    "source": "fp16_teacher_proxy",
    "source_protocol_equivalent": false,
    "shared_frozen_root": "runs/qvla_actquant_table1/frozen",
    "trajectory_count_per_model_unit": 512,
    "batch_size": 1,
    "selection_seed": 42,
    "spatial_bins": 6,
    "warmup_steps": 128,
    "formal_seed_overlap_forbidden": true
  },
  "quantization": {
    "low_weight_bits": 4,
    "activation_bits": 8,
    "weight_granularity": "symmetric_per_output_channel",
    "weight_scale_search": "deterministic_mse_grid_0.50_to_1.00_21_points",
    "activation_granularity": "static_per_input_channel",
    "activation_estimator": "maximum_of_per_batch_99.9_percentiles",
    "activation_calibration_batches": 64,
    "activation_calibration_batch_size": 1,
    "fake_quant_runtime": true,
    "runtime_memory_claim_allowed": false,
    "latency_claim_allowed": false
  },
  "da_mpa": {
    "probe_steps": 16,
    "damping": 0.0003,
    "translation_weight": 1.8,
    "rotation_weight": 0.15,
    "scaling_gain": 1.6,
    "bf16_retention_ratio": 0.30,
    "skip_last_action_blocks": 2,
    "allocation_unit": "action_decoder_mlp_layer",
    "score": "mean_absolute_gradient_under_structural_jacobian_weighted_flow_loss"
  },
  "csrc": {
    "svd_block_size": 16,
    "smoothing": 0.15,
    "group_size": 32,
    "group_shrinkage": 0.55,
    "low_rank": 8,
    "interface_rule": "first_non_skipped_action_mlp_output",
    "folded_into_weight_and_bias": true
  },
  "architecture_mapping": {
    "gr00t": {
      "backbone_low_bit": "backbone.eagle_model.language_model.*.mlp.{gate_proj,up_proj,down_proj}",
      "action_decoder": "action_head.model.transformer_blocks.*.ff.net.{0.proj,2}",
      "action_semantics": "first_7_normalized_dimensions_are_xyz_rotation_vector_gripper"
    },
    "pi05": {
      "backbone_low_bit": "paligemma_with_expert.paligemma.model.language_model.layers.*.mlp.{gate_proj,up_proj,down_proj}",
      "action_decoder": "paligemma_with_expert.gemma_expert.model.layers.*.mlp.{gate_proj,up_proj,down_proj}",
      "mapping_note": "pi0.5 has a flow-transformer action expert rather than a DiT; the expert MLPs inherit the paper's action-decoder role",
      "action_semantics": "first_7_normalized_dimensions_are_xyz_rotation_vector_gripper"
    }
  },
  "source_code_deviations": [
    "The paper allocates precision per layer; commit 94476e3 allocates it per output channel. This protocol follows the paper.",
    "The upstream repository is CogACT/BridgeDataV2/SimplerEnv-specific and has no GR00T, pi0.5, or RoboCasa365 adapter.",
    "The upstream quick-start disables its optional LVC affine path by default although the paper defines CSRC as part of DA-PTQ; this protocol enables folded interface compensation.",
    "The upstream repository declares no software license, so its code is inspected but not vendored."
  ]
}
