{
  "schema_version": 1,
  "method_id": "full_context_fp16_protection_v1",
  "cross_model_protocol": "quantvla-gr00t-pi05-errorfold-v4",
  "teacher": "original_native_fp16_checkpoint",
  "selection_noise": "A",
  "heldout_noise": {
    "name": "B",
    "usage": "audit_only_after_mask_and_activation_mode_are_frozen"
  },
  "deployment": {
    "weight_states": [
      "native_fp16",
      "signed_nibble_group64_w4"
    ],
    "activation_states": [
      "static_per_flow_step_a8",
      "dynamic_per_forward_per_channel_a8"
    ],
    "runtime_selector": false,
    "runtime_correction": false,
    "forbidden_components": [
      "errorfold",
      "atm",
      "ohb",
      "blocksoftfold",
