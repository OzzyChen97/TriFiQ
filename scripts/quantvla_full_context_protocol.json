  "model_hyperparameters": {
    "gr00t": {
      "quantvla_anchor_compression": 2.22,
      "table1_flow_steps": 4
    },
    "pi05": {
      "quantvla_anchor_compression": 2.96,
      "table1_flow_steps": 4
    }
  },
  "byte_budget": {
    "scope": "table1_candidate_linear_tightly_packed_weights_and_required_w4_scales",
    "maximum_quantvla_byte_multiplier": 1.1,
    "layer_count_is_not_a_constraint": true,
    "minimum_approximate_compression": {
      "gr00t": 2.018181818181818,
      "pi05": 2.6909090909090905
    }
  },
  "activation_attribution": {
    "reference": "static_a8",
    "control": "fp16",
    "deployable_alternative": "dynamic_a8",
    "a16_is_deployable": false,
    "a8_bottleneck_rule": "paired_upper_bounds_for_d_func_and_d_pac_are_both_negative",
    "mode_selection_rule": "same_paired_minimax_rule_as_mask_selection"
  },
  "counterfactual_search": {
    "background": "current_complete_w4_fp16_mask",
    "rounds": 2,
    "round_one": "flip_every_w4_target_to_fp16_individually",
    "round_two": "flip_every_target_state_individually_from_round_one_winner",
    "shortlist": false,
    "blocksoftfold_usage": "historical_diagnostic_only",
    "scalarization_lambdas": [
      0.0,
      0.25,
      0.5,
      0.75,
      1.0
    ],
    "budget_solver": "exact_sparse_pareto_01_dynamic_programming",
    "full_network_rescore_required": true
  },
  "selection": {
    "sample_unit": "paired_task_seed_sequence",
    "score": "max((mean(delta_d_func)+SE(delta_d_func))/baseline_d_func,(mean(delta_d_pac)+SE(delta_d_pac))/baseline_d_pac)",
    "required_score": "strictly_less_than_zero",
    "component_constraints": [
      "pose",
      "stitch",
      "grip"
    ],
    "component_rule": "mean(delta_component)<=SE(delta_component)",
    "one_se_reference": "best_full_network_candidate",
    "tie_break": [
      "smallest_static_bytes",
      "fewest_fp16_layers",
      "lexicographically_smallest_fp16_mask"
    ],
    "uses_task_labels": false,
    "uses_success_labels": false,
    "uses_gradients": false,
    "uses_extra_training_data": false
  },
